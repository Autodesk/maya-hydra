-- configuration
{
    "techniques": {
        "default": {
			"displacementShader": {
                "source": [ "customBufferShader.Displacement" ]
            },
            "surfaceShader": {
                "source": [ "customBufferShader.Surface" ]
            }
        }
    }
}

--- --------------------------------------------------------------------------
-- glsl customBufferShader.Displacement

//Optional vertex displacement shader
vec4 displacementShader(int index, vec4 Peye, vec3 Neye, vec4 patchCoord)
{
    //Apply your custom vertex displacement on Peye or remove that function and its definition above for more performance
    return Peye;
}

-- glsl customBufferShader.Surface

vec4
surfaceShader(vec4 Peye, vec3 Neye, vec4 color, vec4 patchCoord)
{
#ifdef HD_HAS_myCustomStreamB
    vec4 customStream = HdGet_myCustomStreamB();
#else
    vec4 customStream = vec4(0);
#endif

    return vec4(customStream.xyz * -0.5 + vec3(0.5), 1.0);
}
