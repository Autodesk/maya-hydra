#usda 1.0
 
def "displacedCubeScene"
{
    def Xform "instancedCube" (
        instanceable = true
        references = @./displacedCube.usda@
    )
    {
        double3 xformOp:translate = (3.9, 1.8, -1.2)
        float3 xformOp:rotateXYZ = (-75, 45, -20)
        float3 xformOp:scale = (2, 1, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }
}
