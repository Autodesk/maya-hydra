#usda 1.0

def GenerativeProcedural "MyGenerativeProcedural" (
    prepend apiSchemas = ["HydraGenerativeProceduralAPI"]
)
{
    token primvars:hdGp:proceduralType = "SimpleHydraGenerativeProceduralPlugin"
    token primvars:materialPath = "Materials"

    def Material "Materials" (
        add references = [
            @./materials/simpleMat.usda@</simpleMat>
	]
    ) 
	{
	}
}