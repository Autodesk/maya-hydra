#usda 1.0
(
    defaultPrim = "root"
)

def Xform "root" (
    kind = "assembly"
)
{
    def Xform "refAssetA" (
        references = @./cube.usda@
        kind = "group"
    )
    {
        double3 xformOp:rotateXYZ = (-90, 0, 0)
        double3 xformOp:translate = (-5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ", "xformOp:translate"]
    }
    def Xform "refAssetB" (
        references = @./cube.usda@
        kind = "group"
    )
    {
        uniform token model:drawMode = "cards"
        double3 xformOp:rotateXYZ = (-90, 0, 0)
        double3 xformOp:translate = (5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ", "xformOp:translate"]
    }
}
