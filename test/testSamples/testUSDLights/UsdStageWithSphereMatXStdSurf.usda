#usda 1.0

def Sphere "Sphere1" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </mtl/standard_surface1>
    double3 xformOp:translate = (0, 0, -2.3244301402269603)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Scope "mtl"
{
    def Material "standard_surface1"
    {
        token outputs:mtlx:surface.connect = </mtl/standard_surface1/standard_surface1.outputs:out>

        def Shader "standard_surface1"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            token outputs:out
        }
    }
}

def DistantLight "DistantLight1"
{
    float inputs:angle = 0.53
    color3f inputs:shadow:color
    bool inputs:shadow:enable = 1
    token visibility = "inherited"
    float3 xformOp:rotateXYZ = (-90, 0, 0)
    double3 xformOp:translate = (0, 8, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
}

def DiskLight "DiskLight1"
{
    float inputs:radius = 2.4875622
    token visibility = "inherited"
    bool inputs:shadow:enable = 1
    float3 xformOp:rotateXYZ = (-90, 0, 0)
    double3 xformOp:translate = (0, 8, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
}

def DomeLight "DomeLight1"
{
    asset inputs:texture:file = @./sky.hdr@
    double3 xformOp:translate = (0, 8.329096001473479, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
	bool inputs:shadow:enable = 1
}

