GITHUB_ORG_NAME = 'media-and-entertainment'
// TODO: When project ecg-maya-hydra is created in Jenkins and the jobs moved, this
//       needs to be updated.
PROJECT_NAME = 'ecg-maya-usd'
pipeline {
    agent {
        label 'mayausd-preload-pool'
    }
    stages {
        stage('Triggering Preflight update submodule') {
            steps {
                sh 'env|sort'
                script {
                        build(
                            job: "ECP/${PROJECT_NAME}/ecg-mayahydra-preflight-update-submodule-master",
                            parameters: [
                                string(name:'DISABLE_MAIL_NOTIFICATIONS', value:'ON')
                            ],
                            wait: false,
                            propagate: false
                        )
                }
            }
        }
    }
}
